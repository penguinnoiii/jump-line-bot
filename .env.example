# Copy to .env for local development (Render uses its own env var settings).

# From LINE Developers Console > your Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=your-long-lived-channel-access-token
LINE_CHANNEL_SECRET=your-channel-secret

# Typhoon (SCB 10X Thai LLM) — free key from https://opentyphoon.ai
TYPHOON_API_KEY=sk-...

# Optional overrides
# TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
# TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1

# --- AIS Open API: Number Verification (optional; mock mode if unset) ---
# Get credentials/docs from AIS: jumpthailand@ais.co.th
# AIS_NUMVERIFY_BASE_URL=https://api.ais.th
# AIS_NUMVERIFY_VERIFY_PATH=/number-verification/v0/verify
# Provide a bearer token directly...
# AIS_NUMVERIFY_TOKEN=
# ...or OAuth2 client credentials:
# AIS_CLIENT_ID=
# AIS_CLIENT_SECRET=
# AIS_TOKEN_URL=
# AIS_SCOPE=

# Optional: local port (Render sets PORT automatically)
# PORT=3000
