# Copy to .env for local development (Render uses its own env var settings).

# From LINE Developers Console > your Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=your-long-lived-channel-access-token
LINE_CHANNEL_SECRET=your-channel-secret

# Typhoon (SCB 10X Thai LLM) — free key from https://opentyphoon.ai
TYPHOON_API_KEY=sk-...

# Optional overrides
# TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
# TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1

# --- Live web grounding (optional; without a key, falls back to general
#     knowledge + disclaimers, same as before) ---
# Free key (~1,000 searches/month): https://tavily.com
# TAVILY_API_KEY=tvly-...

# --- Teacher dashboard (/teacher) ---
# Password teachers use to log in. If unset, a default demo password is used
# (logged on startup) — set this before sharing the URL publicly.
# TEACHER_PASSWORD=choose-a-real-password

# --- Cloud storage for student profiles (optional; falls back to in-memory,
#     which resets on restart, if unset) ---
# Free Redis: https://upstash.com (Redis database → REST API section)
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# --- AIS Open API (optional; both services run in MOCK mode if unset) ---
# Get credentials/docs from AIS: jumpthailand@ais.co.th

# Number Verification
# AIS_NUMVERIFY_BASE_URL=https://api.ais.th
# AIS_NUMVERIFY_VERIFY_PATH=/number-verification/v0/verify

# OTP API (base/token default to the Number Verification ones if unset)
# AIS_OTP_BASE_URL=https://api.ais.th
# AIS_OTP_REQUEST_PATH=/otp/v1/request
# AIS_OTP_VERIFY_PATH=/otp/v1/verify
# AIS_OTP_TOKEN=

# Auth — provide a bearer token directly...
# AIS_NUMVERIFY_TOKEN=
# ...or OAuth2 client credentials (used by both services):
# AIS_CLIENT_ID=
# AIS_CLIENT_SECRET=
# AIS_TOKEN_URL=
# AIS_SCOPE=

# Optional: local port (Render sets PORT automatically)
# PORT=3000
